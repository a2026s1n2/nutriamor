# Copie para .env e use com: docker compose --profile full up --build
# Nunca commite o .env com segredos reais.

DEBUG=False
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1,nutriamor.cienciadedadosunivesp.app.br

# Obrigatório com HTTPS no subdomínio (inclua https://)
CSRF_TRUSTED_ORIGINS=https://nutriamor.cienciadedadosunivesp.app.br

# True quando Nginx/Caddy termina SSL e encaminha para o contentor (porta 8000)
BEHIND_HTTPS_PROXY=True

# Sobrescrito pelo docker-compose para o serviço web (host = db):
# DATABASE_URL=postgres://nutriamor:nutriamor@db:5432/nutriamor

USE_SQLITE=False
