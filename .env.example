# Copie para .env e ajuste
DEBUG=True
SECRET_KEY=altere-para-uma-chave-segura-em-producao
ALLOWED_HOSTS=127.0.0.1,localhost

DATABASE_URL=postgres://nutriamor:nutriamor@127.0.0.1:5432/nutriamor

# Desenvolvimento sem PostgreSQL: USE_SQLITE=True
USE_SQLITE=False

# --- Docker (stack web+db) ---
# cp .env.docker.example .env  e ajuste SECRET_KEY / ALLOWED_HOSTS (inclua o IP ou domínio do servidor)
# Subir:  docker compose --profile full up --build
# App: http://localhost:8000
# Só Postgres (dev local):  docker compose up -d db
